# Configuración de Carrete. Copia este fichero a deploy/.env y rellénalo.
# .env NO va a git: contiene secretos. Guarda una copia de los secretos en tu gestor de contraseñas.

# --- Imagen ------------------------------------------------------------------------------------------
# Para volver a una versión anterior, fija la etiqueta del commit: ghcr.io/javier-hernaez/carrete:<sha>
CARRETE_IMAGE=ghcr.io/javier-hernaez/carrete:latest

# --- Dirección pública -------------------------------------------------------------------------------
# Nunca se escribe en el código: si cambia el túnel o el dominio, solo se cambia aquí.
# Mientras no se active el Funnel basta con http://127.0.0.1:8010
CARRETE_PUBLIC_URL=https://javier-default-string.taila9c233.ts.net:10000
# Puerto local (solo 127.0.0.1). Tailscale Funnel lo expone con:
#   tailscale funnel --bg --https=10000 http://127.0.0.1:8010
CARRETE_PORT=8010

# --- Secretos ------------------------------------------------------------------------------------------
# Genera cada uno con: openssl rand -hex 32   (hex: sin caracteres que haya que escapar en URL)
POSTGRES_PASSWORD=
CARRETE_SECRET_KEY=

# --- Carpetas del equipo (montajes bind, no volúmenes de Docker) -------------------------------------
# Una carpeta raíz con dos subcarpetas (créalas con deploy/scripts/preparar-carpetas.sh):
#   datos/   originales, derivados, subidas a medias, exportaciones y biblioteca en disco
#   copias/  copias de seguridad; app y worker no tienen acceso
# Van juntas para que la copia de originales use enlaces duros (no ocupa espacio). Ver ADR 0008.
CARRETE_ROOT=/home/javier/carrete
# Usuario y grupo dueños de esas carpetas (id -u / id -g). Los contenedores corren con ellos.
CARRETE_UID=1000
CARRETE_GID=1000

# --- Seguridad -----------------------------------------------------------------------------------------
# Segundo factor obligatorio para todas las cuentas (recomendado al estar expuesto a internet).
CARRETE_REQUIRE_2FA=true
# Proxies cuya cabecera X-Forwarded-For se cree (IP real para límites de intentos y auditoría).
CARRETE_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# --- Subidas y disco -------------------------------------------------------------------------------------
# Tamaño máximo por fichero (10 GiB) y reserva de disco por debajo de la cual se rechazan subidas (20 GB).
CARRETE_MAX_UPLOAD_BYTES=10737418240
CARRETE_MIN_FREE_BYTES=20000000000

# --- Mapa ----------------------------------------------------------------------------------------------
# Estilo de teselas vectoriales para MapLibre. Por defecto OpenFreeMap, público y sin clave: el navegador
# solo le pide las zonas que se miran, nunca fotos ni coordenadas. Vacío = sección Mapa oculta.
CARRETE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Otros ---------------------------------------------------------------------------------------------
TZ=Europe/Madrid
CARRETE_LOG_LEVEL=INFO
