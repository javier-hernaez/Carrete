<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Conservar la ubicación GPS de las fotos al leerlas. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <application
        android:name=".CarreteApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Carrete"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <!-- Exportada por fuerza: es la pantalla de inicio que abre el lanzador del sistema. -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- El QR de Ajustes → App para el móvil abre «carrete:https://…» con la dirección ya puesta.
             Exportada para recibir ese enlace; solo rellena el campo, que se ve y se puede cambiar, y
             no guarda nada hasta que la persona entra con usuario, contraseña y código. -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity -->
        <activity
            android:name=".SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="carrete" />
            </intent-filter>
        </activity>

        <!-- Destino de «Compartir» para una o varias fotos y vídeos. Exportada para que otras apps
             puedan compartir con Carrete; solo acepta imágenes y vídeos y pide elegir el espacio. -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:theme="@style/Theme.Carrete.Dialog">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- WorkManager en primer plano para la cola de subida (Android 14 exige el tipo). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
